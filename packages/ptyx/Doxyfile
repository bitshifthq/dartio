PROJECT_NAME           = "ptyx C ABI"
PROJECT_BRIEF          = "Stable PTY C ABI and private Dart adapter"
OUTPUT_DIRECTORY       = packages/ptyx/native/target/doxygen
INPUT                  = packages/ptyx/include/ptyx.h \
                         packages/ptyx/include/ptyx_dart.h
FILE_PATTERNS          = *.h
RECURSIVE              = NO
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXCLUDE_SYMBOLS        = PTYX_EXPORT PTYX_CALL
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
